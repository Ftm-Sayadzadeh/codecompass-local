# Optional backend defaults
CODECOMPASS_PROVIDER=ollama
CODECOMPASS_BASE_URL=http://127.0.0.1:11434
CODECOMPASS_EMBEDDING_MODEL=nomic-embed-text-local:latest
CODECOMPASS_LLM_MODEL=qwen2.5-coder-3b-codecompass:latest
CODECOMPASS_TIMEOUT_SECONDS=60

# Nomic embedding preset (local defaults are used when omitted)
CODECOMPASS_NOMIC_BASE_URL=http://127.0.0.1:11434
CODECOMPASS_NOMIC_EMBEDDING_MODEL=nomic-embed-text-local:latest

# Gemini Embedding 001 preset
CODECOMPASS_EMBEDDING_COMPARE_BASE_URL=https://api.avalai.ir/v1
CODECOMPASS_EMBEDDING_COMPARE_API_KEY=<api-key>
CODECOMPASS_EMBEDDING_COMPARE_MODEL=gemini-embedding-001
CODECOMPASS_EMBEDDING_COMPARE_DIMENSIONS=3072

# Gemini Embedding 2 preset
CODECOMPASS_GEMINI2_EMBEDDING_BASE_URL=https://api.avalai.ir/v1
CODECOMPASS_GEMINI2_EMBEDDING_API_KEY=<api-key>
CODECOMPASS_GEMINI2_EMBEDDING_MODEL=gemini-embedding-2
CODECOMPASS_GEMINI2_EMBEDDING_DIMENSIONS=3072

# Qwen LLM preset (local defaults are used when omitted)
CODECOMPASS_QWEN_BASE_URL=http://127.0.0.1:11434
CODECOMPASS_QWEN_LLM_MODEL=qwen2.5-coder-3b-codecompass:latest

# GLM LLM preset
CODECOMPASS_COMPARE_BASE_URL=https://api.avalai.ir/v1
CODECOMPASS_COMPARE_API_KEY=<api-key>
CODECOMPASS_COMPARE_MODEL=glm-5.3-flash
